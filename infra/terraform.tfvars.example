# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars if it
# ends up holding anything sensitive (it shouldn't, by design — secrets are
# generated by Terraform itself into Secrets Manager, not passed in here).

aws_region   = "us-east-1"
environment  = "production"
project_name = "carecoord-hub"

availability_zones = ["us-east-1a", "us-east-1b"]

db_instance_class       = "db.t4g.micro" # bump for real load: db.t4g.medium+
db_multi_az             = true           # recommended for production
db_backup_retention_days = 30

app_desired_count = 2
app_cpu           = 512
app_memory        = 1024

# Leave both blank for a first bootstrap apply (HTTP-only via the raw ALB
# DNS name). Fill in once you own the domain and have a Route53 hosted zone
# for it — Terraform will provision + validate the ACM cert and point DNS
# at the ALB automatically.
domain_name     = ""
route53_zone_id = ""

alert_email = ""
