# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars if it
# ends up holding anything sensitive (it shouldn't, by design — secrets are
# generated by Terraform itself into Secrets Manager, not passed in here).
#
# These values are a lean PILOT profile: real encryption, private
# networking, RBAC, and audit logging (never negotiable), but minimal
# redundancy (very negotiable) to keep cost down. See infra/README.md's
# "Cost" section for the pilot-vs-scaled-up estimate and exactly which
# knobs below are compliance-relevant vs. pure uptime spend.

aws_region   = "us-east-1"
environment  = "pilot"
project_name = "carecoord-hub"

availability_zones = ["us-east-1a", "us-east-1b"] # ALB needs 2 regardless of single_nat_gateway

single_nat_gateway = true # ~$32/mo instead of ~$64/mo; flip to false before go-live if AZ outages must not cause a blip

db_instance_class        = "db.t4g.micro" # bump for real load: db.t4g.medium+
db_multi_az              = false          # flip to true before go-live for automatic failover
db_backup_retention_days = 7              # brand-new/free-tier AWS accounts can reject higher values with FreeTierRestrictionError; raise once the account is past that restriction

app_desired_count = 1 # bump to 2+ once zero-downtime deploys matter
app_cpu           = 512
app_memory        = 1024

# Leave both blank for a first bootstrap apply (HTTP-only via the raw ALB
# DNS name). Fill in once you own the domain and have a Route53 hosted zone
# for it — Terraform will provision + validate the ACM cert and point DNS
# at the ALB automatically.
domain_name     = ""
route53_zone_id = ""
